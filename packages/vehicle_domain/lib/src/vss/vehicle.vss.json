                "default": false
              },
              "PowerOpeningAngle": {
                "type": "actuator",
                "datatype": "float",
                "unit": "degrees",
                "min": 0,
                "max": 90,
                "default": 0.0,
                "description": "Power tailgate angle. 0 = closed."
              },
              "Front": {
                "type": "branch",
                "children": {
                  "IsOpen": {
                    "type": "actuator",
                    "datatype": "boolean",
                    "default": false,
                    "description": "Front trunk (frunk)."
                  }
                }
              }
            }
          },
          "Trailer": {
            "type": "branch",
            "children": {
              "IsConnected": {
                "type": "sensor",
                "datatype": "boolean",
                "default": false
              },
              "BrakeGain": {
                "type": "actuator",
                "datatype": "float"
              }
            }
          },
          "Lights": {
            "type": "branch",
            "children": {
              "IsLeftIndicatorOn": {
                "type": "actuator",
                "datatype": "boolean"
              },
              "IsRightIndicatorOn": {
                "type": "actuator",
                "datatype": "boolean"
              },
              "IsHazardOn": {
                "type": "actuator",
                "datatype": "boolean",
                "default": false
              },
              "MatrixBeamMode": {
                "type": "actuator",
                "datatype": "string"
              }
            }
          },
          "IsCrashDetected": {
            "type": "sensor",
            "datatype": "boolean",
            "default": false
          }
        }
      },
      "Media": {
        "type": "branch",
        "children": {
          "ActiveSoundDesign": {
            "type": "actuator",
            "datatype": "string"
          },
          "ActiveNoiseCancellation": {
            "type": "actuator",
            "datatype": "boolean"
          },
          "SoundZoneBalance": {
            "type": "actuator",
            "datatype": "string"
          }
        }
      },
      "ADAS": {
        "type": "branch",
        "children": {
          "ACC": {
            "type": "branch",
            "children": {
              "IsEngaged": {
                "type": "actuator",
                "datatype": "boolean",
                "default": false
              },
              "SetSpeed": {
                "type": "actuator",
                "datatype": "float",
                "unit": "km/h",
                "min": 30,
                "max": 180,
                "default": 100.0
              }
            }
          },
          "ObstacleDetection": {
            "type": "branch",
            "children": {
              "LeadVehicle": {
                "type": "sensor",
                "datatype": "string",
                "description": "Lead vehicle object serialized as JSON."
              }
            }
          },
          "LaneKeepingAssist": {
            "type": "branch",
            "children": {
              "Status": {
                "type": "sensor",
                "datatype": "string"
              },
              "LeftLaneOffsetMeters": {
                "type": "sensor",
                "datatype": "float"
              },
              "RightLaneOffsetMeters": {
                "type": "sensor",
                "datatype": "float"
              },
              "IsEnabled": {
                "type": "actuator",
                "datatype": "boolean",
                "default": false
              }
            }
          },
          "HillDescentControl": {
            "type": "branch",
            "children": {
              "IsEnabled": {
                "type": "actuator",
                "datatype": "boolean",
                "default": false
              }
            }
          },
          "ESC": {
            "type": "branch",
            "children": {
              "Mode": {
                "type": "actuator",
                "datatype": "string",
                "allowed": [
                  "NORMAL",
                  "WET",
                  "SPORT_PLUS",
                  "OFF"
                ],
                "default": "NORMAL",
                "description": "Electronic stability control mode."
              }
            }
          },
          "SpeedLimiter": {
            "type": "branch",
            "children": {
              "SetSpeed": {
                "type": "actuator",
                "datatype": "float",
                "unit": "km/h",
                "min": 30,
                "max": 250,
                "default": 250.0
              }
            }
          }
        }
      },
      "Software": {
        "type": "branch",
        "children": {
          "OTA": {
            "type": "branch",
            "children": {
              "Status": {
                "type": "sensor",
                "datatype": "string",
                "allowed": [
                  "IDLE",
                  "UPDATE_AVAILABLE",
                  "INSTALLING"
                ],
                "default": "UPDATE_AVAILABLE"
              },
              "IsInstalling": {
                "type": "actuator",
                "datatype": "boolean",
                "default": false,
                "description": "Requests/reports an OTA installation."
              }
            }
          }
        }
      },
      "Exterior": {
        "type": "branch",
        "children": {
          "AirTemperature": {
            "type": "sensor",
            "datatype": "float",
            "unit": "celsius",
            "min": -40,
            "max": 60,
            "default": 20.0
          }
        }
      }
    }
  }
}
